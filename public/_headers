# Cloudflare static assets. Without this every file is served with
# "max-age=0, must-revalidate" and a return visit revalidates all of them.

# Content-hashed by Next.js: safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Gallery screenshots and scanned textures: not hashed, so a day fresh, then
# served from cache while a new copy is fetched in the background.
/gallery/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
